# Copy this file to .env and fill in the values. Never commit .env.

# Bot token from the Discord Developer Portal (Applications -> Bot -> Token)
DISCORD_TOKEN=

# The server this bot operates in
GUILD_ID=

# Role IDs. Enable Developer Mode (User Settings -> Advanced) and
# right-click a role in Server Settings to copy its ID.
ROLE_ITF=
ROLE_APP_AI=
ROLE_DIGITAL_INNOVATION=
ROLE_YEAR_2=
ROLE_YEAR_3=
ROLE_ALUMNI=
ROLE_DOCENT=
ROLE_ETHICAL_HACKING=
ROLE_CLOUD_AUTOMATION_DEFENCE=

# Channel where role requests land for mod approval (mod-only channel)
REQUEST_CHANNEL_ID=

# Role that may run the admin commands (rollout, interview, status, reset)
MAINTAINER_ROLE_ID=

# Optional: where the sqlite database lives. Defaults to ./blahajd.db
DB_PATH=blahajd.db
